{
  "name": "zovex-desktop",
  "productName": "ZOVEX",
  "version": "1.0.4",
  "description": "ZOVEX — צפייה ישירה בסרטים, סדרות ושידורים חיים",
  "author": {
    "name": "ZOVEX",
    "email": "support@zovex.app"
  },
  "license": "UNLICENSED",
  "private": true,
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -r \"npm:dev:vite\" \"npm:dev:watch\" \"npm:dev:app\"",
    "dev:vite": "vite",
    "build:electron": "node scripts/build-electron.mjs",
    "build:renderer": "vite build",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm run build:renderer && npm run build:electron",
    "icons": "node scripts/make-icons.mjs",
    "start": "electron .",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "pack:dir": "npm run build && electron-builder --dir --publish never",
    "dev:watch": "node scripts/build-electron.mjs --watch --dev",
    "dev:app": "node scripts/dev-electron.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.59.16",
    "@tanstack/react-virtual": "3.10.8",
    "clsx": "2.1.1",
    "hls.js": "1.5.17",
    "lucide-react": "0.454.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.27.0",
    "zustand": "5.0.0"
  },
  "devDependencies": {
    "@types/node": "22.7.9",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "concurrently": "9.0.1",
    "electron": "33.0.2",
    "electron-builder": "25.1.8",
    "esbuild": "0.24.0",
    "png-to-ico": "2.1.8",
    "sharp": "0.33.5",
    "typescript": "5.6.3",
    "vite": "5.4.10"
  }
}